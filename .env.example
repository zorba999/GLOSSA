# Copy to .env.local and fill in.

# Only needed locally, for scripts/deploy.mjs. Never set this in Vercel:
# the browser app signs with the visitor's own wallet, never with this key.
DEPLOYER_PRIVATE_KEY=0x...

# Set these two in Vercel (Project -> Settings -> Environment Variables).
NEXT_PUBLIC_GLOSSA_ADDRESS=0x...
NEXT_PUBLIC_GENLAYER_NETWORK=studionet
